# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CEO_INITIAL_PIN: Optional server-side override PIN for the CEO account.
# Leave empty to use the first-run setup screen in the browser.
CEO_INITIAL_PIN=

# SESSION_SECRET: Optional server-side secret for signing/deriving tokens.
# If omitted, a secure random secret is generated in memory at startup.
SESSION_SECRET=

# TRUST_PROXY: set to 1 when running behind a reverse proxy / PaaS so rate limiting uses the real client IP.
TRUST_PROXY=

# SEED_DEMO_DATA: set to 1 only for local testing to insert sample orders/checks. Leave empty in production.
SEED_DEMO_DATA=
