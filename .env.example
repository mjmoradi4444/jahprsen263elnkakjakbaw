# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CEO_INITIAL_PIN: Optional server-side override PIN for the CEO account.
# Leave empty to use the first-run setup screen in the browser.
CEO_INITIAL_PIN=

# SESSION_SECRET: Optional server-side secret for signing/deriving tokens.
# If omitted, a secure random secret is generated in memory at startup.
SESSION_SECRET=

# ==================== Supabase Storage & Database RLS (Server-Side Only) ====================
# NEVER prefix these with VITE_ — keys must remain strictly on the server.
# When configured, images/PDFs/signatures are stored in private Supabase Storage
# and database access is enforced via role-scoped HS256 RLS JWTs.
# When omitted in local preview, the server automatically uses confined local fallback storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET="autoparts-documents"
# Set to "true" to serve files via direct Supabase Storage public URLs (getPublicUrl).
# Keep "false" (default) for private buckets with 60s RBAC-gated signed URLs on check photos & invoices.
SUPABASE_STORAGE_PUBLIC="false"


# TRUST_PROXY: set to 1 when running behind a reverse proxy / PaaS (Liara, Render...) so login
# rate limiting uses each client's real IP.
TRUST_PROXY=

# SEED_DEMO_DATA: set to 1 ONLY for local testing to insert sample orders/checks. Leave empty in production.
SEED_DEMO_DATA=

# DATA_DIR: folder for the SQLite database and local uploads. Defaults to ./data.
# On Liara, mount a disk at /data and set DATA_DIR=/data so data survives redeploys.
DATA_DIR=
